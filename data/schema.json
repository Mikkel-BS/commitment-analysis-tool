{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Commitment Atlas dataset","description":"Normative schema for claims and rules. Individual files are validated by scripts/validate.mjs.","$defs":{"literal":{"type":"object","required":["claim","polarity"],"properties":{"claim":{"type":"string","pattern":"^[A-Z][A-Z0-9-]+$"},"polarity":{"enum":["affirm","deny"]}},"additionalProperties":false},"claim":{"type":"object","required":["id","title","statement","description","category","tags","sources"],"properties":{"id":{"type":"string","pattern":"^[A-Z][A-Z0-9-]+$"},"title":{"type":"string","minLength":3},"statement":{"type":"string","minLength":10},"description":{"type":"string","minLength":10},"category":{"type":"string"},"tags":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},"sources":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true}},"additionalProperties":false},"rule":{"type":"object","required":["id","title","premises","kind","status","strength","explanation","caveat","objections","sources"],"properties":{"id":{"type":"string","pattern":"^R-[A-Z0-9-]+$"},"title":{"type":"string"},"premises":{"type":"array","items":{"$ref":"#/$defs/literal"},"minItems":1},"conclusion":{"$ref":"#/$defs/literal"},"target":{"$ref":"#/$defs/literal"},"kind":{"enum":["entails","incompatible","tension","supports","undercuts"]},"status":{"enum":["formal","conceptual","widely-defended","contested","interpretation-dependent"]},"strength":{"enum":["deductive","dialectical"]},"explanation":{"type":"string"},"caveat":{"type":"string"},"objections":{"type":"array","items":{"type":"string"}},"sources":{"type":"array","items":{"type":"string"},"minItems":1}},"additionalProperties":false}}}
