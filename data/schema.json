{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commitment Atlas dataset",
  "description": "Normative schema for claims and rules. Individual files are validated by scripts/validate.mjs.",
  "$defs": {
    "literal": {
      "type": "object",
      "required": [
        "claim",
        "polarity"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "polarity": {
          "enum": [
            "affirm",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "title",
        "statement",
        "description",
        "category",
        "tags",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "title",
        "premises",
        "kind",
        "status",
        "strength",
        "explanation",
        "caveat",
        "objections",
        "sources",
        "assessment",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "premises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          },
          "minItems": 1
        },
        "conclusion": {
          "$ref": "#/$defs/literal"
        },
        "target": {
          "$ref": "#/$defs/literal"
        },
        "kind": {
          "enum": [
            "entails",
            "incompatible",
            "tension",
            "supports",
            "undercuts"
          ]
        },
        "status": {
          "enum": [
            "formal",
            "conceptual",
            "widely-defended",
            "contested",
            "interpretation-dependent"
          ]
        },
        "strength": {
          "enum": [
            "deductive",
            "dialectical"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "assessment": {
          "type": "object",
          "properties": {
            "inference": {
              "enum": [
                "definition-relative",
                "not-established",
                "truth-table-checked"
              ]
            },
            "premises": {
              "enum": [
                "disputed",
                "stipulated"
              ]
            },
            "framework": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "justification": {
              "type": "string",
              "minLength": 1
            },
            "review": {
              "enum": [
                "editorial-audit"
              ]
            },
            "reviewedOn": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "inference",
            "premises",
            "framework",
            "scope",
            "justification",
            "review",
            "reviewedOn"
          ],
          "additionalProperties": false
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "locator",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "objectionTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "showIncomplete": {
          "type": "boolean"
        },
        "formalization": {
          "type": "object",
          "properties": {
            "atoms": {
              "type": "object",
              "properties": {
                "G": {
                  "type": "string",
                  "minLength": 1
                },
                "N": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "G",
                "N"
              ],
              "additionalProperties": false
            },
            "premises": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/formula"
              },
              "minItems": 1
            },
            "conclusion": {
              "$ref": "#/$defs/formula"
            }
          },
          "required": [
            "atoms",
            "premises",
            "conclusion"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "formula": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "G",
            "N"
          ]
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "not"
            },
            {
              "$ref": "#/$defs/formula"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "implies"
            },
            {
              "$ref": "#/$defs/formula"
            },
            {
              "$ref": "#/$defs/formula"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      ]
    }
  }
}
